{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vite Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Debug In Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Debug StockAI App",
      "configurations": ["Run Vite Dev Server", "Debug In Chrome"]
    }
  ]
}
